# ═══════════════════════════════════════════════════════════════════════════
# NEXUS AI SWARM PLATFORM — Environment Configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────
NEXUS_ENV=development
NEXUS_DEBUG=true
NEXUS_API_PREFIX=/api
# Comma separated origins, or * for all (dev only)
NEXUS_CORS_ORIGINS=*

# ── Database ────────────────────────────────────────────────────────────────
# Default: local async SQLite. Production example:
#   postgresql+asyncpg://nexus:nexus@postgres:5432/nexus
NEXUS_DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db

# ── Key Vault (AES-256-GCM at rest) ─────────────────────────────────────────
# Master passphrase used to derive the vault encryption key via PBKDF2/Argon2.
# If unset, the vault starts LOCKED and must be unlocked via the UI / API.
NEXUS_VAULT_MASTER_KEY=
NEXUS_VAULT_KDF_ALGORITHM=pbkdf2            # pbkdf2 | argon2
NEXUS_VAULT_PBKDF2_ITERATIONS=100000
NEXUS_VAULT_ARGON2_TIME_COST=3
NEXUS_VAULT_ARGON2_MEMORY_COST=65536
NEXUS_VAULT_ARGON2_PARALLELISM=4
NEXUS_VAULT_AUTO_UNLOCK=true

# ── AI Provider Router ──────────────────────────────────────────────────────
NEXUS_PROVIDERS_CONFIG_PATH=app/config/providers.json
NEXUS_PROVIDER_TIMEOUT_SECONDS=120
NEXUS_PROVIDER_STREAM_TIMEOUT_SECONDS=300
NEXUS_RATE_LIMIT_WINDOW_SECONDS=60
NEXUS_RATE_LIMIT_MAX_REQUESTS=20
NEXUS_CIRCUIT_FAILURE_THRESHOLD=3
NEXUS_CIRCUIT_RESET_SECONDS=60
NEXUS_TOKEN_BUDGET_PER_JOB=400000

# ── GitHub Ingestion Engine ─────────────────────────────────────────────────
NEXUS_CLONE_ROOT=./workspace/repos
NEXUS_CLONE_DEPTH=1
NEXUS_MAX_REPO_SIZE_MB=500

# ── Swarm Orchestration & Self-Healing Loop ─────────────────────────────────
NEXUS_MAX_REPAIR_ITERATIONS=3
NEXUS_EXECUTION_ENABLED=true
NEXUS_EXECUTION_TIMEOUT_SECONDS=180
NEXUS_LINT_COMMAND=ruff check --quiet .
NEXUS_TEST_COMMAND=python -m pytest -x -q

# ── Event Bus / Streaming ───────────────────────────────────────────────────
NEXUS_EVENT_BUS_MAX_QUEUE=2000

# ── Frontend (build-time) ───────────────────────────────────────────────────
VITE_NEXUS_API_BASE=/api
